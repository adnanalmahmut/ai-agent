{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/pre-tool.mjs codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/stop-check.mjs codex",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
