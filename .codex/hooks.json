{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/pre-tool.mjs\" codex",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.agents/hooks/pre-tool.mjs') codex\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/stop-check.mjs\" codex",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"$root = git rev-parse --show-toplevel; & node (Join-Path $root '.agents/hooks/stop-check.mjs') codex\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
