# Copy to /etc/ai-agent/runtime.env on each VPS. The real file is root-owned
# mode 0600 and is never copied into the repository or a container image.
NODE_ENV=
APP_NAME=
APP_SHUTDOWN_READINESS_DELAY_MS=
APP_SHUTDOWN_TIMEOUT_MS=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_MS=
REDIS_URL=
REDIS_KEY_PREFIX=
REDIS_CONNECT_TIMEOUT_MS=
REDIS_COMMAND_TIMEOUT_MS=
REDIS_MAX_RETRIES_PER_REQUEST=
QUEUE_PREFIX=
QUEUE_WORKER_CONCURRENCY=
QUEUE_JOB_ATTEMPTS=
QUEUE_JOB_BACKOFF_MS=
QUEUE_COMPLETED_AGE_SECONDS=
QUEUE_COMPLETED_COUNT=
QUEUE_FAILED_AGE_SECONDS=
QUEUE_FAILED_COUNT=
QUEUE_SHUTDOWN_GRACE_MS=
OUTBOX_POLL_INTERVAL_MS=
OUTBOX_BATCH_SIZE=
OUTBOX_LEASE_MS=
OUTBOX_WARN_AFTER_ATTEMPTS=
AGENT_RUN_RECONCILE_INTERVAL_MS=
AGENT_RUN_RECONCILE_STALE_AFTER_MS=
AGENT_RUN_RECONCILE_BATCH_SIZE=
GEOIP_DATABASE_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb
GEOIP_READER_RETRY_MS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_POINTS=60
RATE_LIMIT_DURATION_SEC=60
RATE_LIMIT_HEADER_PREFIX=RateLimit
RATE_LIMIT_REDIS_FAILURE_POLICY=open
# Active base64-encoded 32-byte key (`openssl rand -base64 32`), its stable
# non-secret version, and optional comma-separated decrypt-only
# `version=base64` entries. Bootstrap-only: key material cannot live beside the
# ciphertext it decrypts.
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_ACTIVE_KEY_VERSION=
APP_ENCRYPTION_DECRYPT_KEYS=
# The internal execution boundary. A JSON array of
# { serviceId, tokenSha256, capabilities }; only SHA-256 digests are
# configured, never a token, and any other property refuses the boot. Empty or
# absent authenticates nobody, which is the correct default until an
# out-of-process runtime is actually deployed.
INTERNAL_SERVICE_CREDENTIALS=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_RATE_LIMIT_ENABLED=true
APP_PLATFORM_URL=

# Optional. Each surface's origin, stated explicitly. Left empty the app and
# API origins are derived from APP_PLATFORM_URL and BETTER_AUTH_URL, which is
# what a single-host deployment wants. A value that contradicts those fails at
# startup. APP_ORIGIN_ADMIN stays empty until an environment actually serves
# the administrative surface; see OP-3 in docs/security.md.
APP_ORIGIN_PUBLIC=
APP_ORIGIN_APP=
APP_ORIGIN_ADMIN=
APP_ORIGIN_API=
OPENAPI_ENABLED=
OPENAPI_PATH=
LOG_LEVEL=
LOG_PRETTY=
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_DRIVER=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_LOG_WRITE_HTML=
MAIL_TIMEOUT_MS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
