#!/bin/sh
set -eu

readonly_root=/opt/ai-agent
runtime_env=/etc/ai-agent/runtime.env
environment_file=/etc/ai-agent/environment
state_dir=/var/lib/ai-agent
compose_file=$readonly_root/docker-compose.yml
# The shared model plus the deployment overlay. Two files because the
# repository states development, test, and deployment as separate overlays over
# one shared file, and a host is installed with only the overlay it is entitled
# to — the development credential fallbacks are in neither file installed here.
# The shared file keeps its original destination, so the recorded manifest, the
# backup units, and the preflight paths are all unaffected.
compose_deploy_file=$readonly_root/docker-compose.deploy.yml
preflight=/usr/local/sbin/ai-agent-runtime-preflight
host_preflight=/usr/local/sbin/ai-agent-host-preflight
retention=/usr/local/sbin/ai-agent-release-retention
current_release=$state_dir/CURRENT_RELEASE.json
previous_release=$state_dir/PREVIOUS_RELEASE.json
registry=ghcr.io/adnanalmahmut/ai-agent

# Pulling and extracting the four release images is the deploy step most likely
# to exhaust a small Lightsail plan, and it fails there partway through a
# release that has already started. Refused up front instead.
required_free_mib=4096

# Extensions a migration in this release creates and therefore cannot create
# itself if the image does not carry them. Kept in sync with the migrations by
# ops/tests/host-bundle.sh, because `CREATE EXTENSION vector` failing inside the
# migration container is exactly the failure this list exists to prevent.
required_extensions='vector'

die() { echo "deployment rejected: $*" >&2; exit 64; }

[ -r "$environment_file" ] || die 'host environment is not configured'
environment=$(sed -n '1p' "$environment_file")
[ "$environment" = staging ] || [ "$environment" = production ] || die 'invalid host environment'
[ "${2:-}" = "$environment" ] || die 'requested environment does not match this host'
[ -f "$compose_file" ] || die 'compose file is not installed'
[ -f "$compose_deploy_file" ] ||
  die 'deployment compose overlay is not installed; reinstall the host bundle'
[ -f "$runtime_env" ] || die 'runtime.env is not installed'
[ -x "$preflight" ] || die 'runtime preflight is not installed'
[ -x "$host_preflight" ] || die 'host preflight is not installed; reinstall the host bundle'
# Scoped to `deploy`, the only verb that runs retention. `health` is the
# diagnostic an operator reaches for during an incident, and a missing retention
# executable must not turn it into a refusal.
[ "${1:-}" != deploy ] || [ -x "$retention" ] ||
  die 'release retention is not installed; reinstall the host bundle'

compose() {
  docker compose --file "$compose_file" --file "$compose_deploy_file" \
    --env-file "$runtime_env" --profile "$environment" "$@"
}

# `migrate` lives in the `migration` profile, so the active-profile view above
# does not resolve it. Only the image-agreement check needs to see it.
compose_with_migration() {
  docker compose --file "$compose_file" --file "$compose_deploy_file" \
    --env-file "$runtime_env" --profile "$environment" --profile migration "$@"
}

validate_sha() {
  printf '%s' "$1" | grep -Eq '^[0-9a-f]{40}$' || die 'SHA must be 40 lowercase hex characters'
}

validate_digest() {
  printf '%s' "$1" | grep -Eq '^[0-9a-f]{64}$' || die 'digest must be 64 lowercase hex characters'
}

api_health() {
  curl --fail --silent --show-error --max-time 10 'http://127.0.0.1:3002/api/health/ready' >/dev/null
}

require_running() {
  service=$1
  running=$(compose ps --status running --services "$service")
  [ "$running" = "$service" ] || die "$service is not running"
}

health() {
  for service in backend worker web platform; do
    require_running "$service"
  done
  api_health
}

write_release_manifest() {
  destination=$1
  sha=$2
  backend_digest=$3
  migration_digest=$4
  web_digest=$5
  platform_digest=$6
  temporary=$destination.tmp.$$

  umask 077
  printf '{"sha":"%s","backend":"sha256:%s","migration":"sha256:%s","web":"sha256:%s","platform":"sha256:%s"}\n' \
    "$sha" "$backend_digest" "$migration_digest" "$web_digest" "$platform_digest" >"$temporary"
  mv "$temporary" "$destination"
}

pull_release_images() {
  # Small Lightsail hosts can exhaust memory and I/O when Compose downloads and
  # extracts every large image concurrently. Pull each distinct image in order;
  # worker shares the backend image and therefore needs no separate pull.
  for service in platform web backend migrate; do
    compose pull "$service"
  done
}

# A release states which host it needs through labels on its own immutable
# images, not through a new deploy argument: the dispatcher's forced-command
# grammar is the trust boundary for the CI deploy key and stays exactly as wide
# as it is, and an argument would also force every host into lockstep with every
# release. A label travels with the digest, is readable after the pull and
# before migrations, and lets an older bundle keep serving releases whose
# minimum it already satisfies.
image_label() {
  image=$1
  label=$2
  value=$(docker image inspect --format "{{ index .Config.Labels \"$label\" }}" "$image" 2>/dev/null) ||
    die "release image is not present locally after the pull"
  # Verified against an attested bake push pulled by index digest: an absent
  # label comes back empty on Docker 29 and as `<no value>` on older releases.
  [ -n "$value" ] && [ "$value" != '<no value>' ] || die "release image does not declare $label"
  printf '%s' "$value"
}

verify_release_declaration() {
  sha=$1
  minimum=

  for image in "$BACKEND_IMAGE" "$BACKEND_MIGRATION_IMAGE" "$WEB_IMAGE" "$PLATFORM_IMAGE"; do
    # Ties the four digests to one release. Digests are immutable but not
    # necessarily related: four valid digests from four different builds would
    # otherwise deploy as a release that was never tested together.
    declared_sha=$(image_label "$image" io.ai-agent.release.sha)
    [ "$declared_sha" = "$sha" ] ||
      die 'release image does not belong to the requested release'

    declared=$(image_label "$image" io.ai-agent.host-bundle.min-version)
    printf '%s' "$declared" | grep -Eq '^[1-9][0-9]*$' ||
      die 'release declares a malformed host bundle minimum'
    if [ -z "$minimum" ]; then
      minimum=$declared
    else
      [ "$declared" = "$minimum" ] || die 'release images disagree on the host bundle minimum'
    fi
  done

  "$host_preflight" require-version "$minimum"
}

# The installed compose file passing an existence check is what let Staging
# deploy a release against a compose file that predated it. This asserts what
# the file actually resolves to: the four pinned digests, and no mutable
# application tag anywhere.
verify_compose_images() {
  images=$(compose_with_migration config --images)

  for reference in "$BACKEND_IMAGE" "$BACKEND_MIGRATION_IMAGE" "$WEB_IMAGE" "$PLATFORM_IMAGE"; do
    printf '%s\n' "$images" | grep -Fxq "$reference" ||
      die 'installed compose file does not resolve the pinned release images'
  done

  if printf '%s\n' "$images" | grep -Eq "^$registry/(backend|backend-migration|web|platform):"; then
    die 'installed compose file resolves a mutable application tag'
  fi
}

# Migrations run inside a container that can only report what it finds. When the
# installed compose file pinned stock PostgreSQL, `CREATE EXTENSION vector`
# failed there — after the release had been pulled and the database was already
# up. Asked of the running database first, so it is a refusal instead of a
# half-applied release. The extension names are code-owned and shape-checked, so
# interpolating them into the query introduces nothing the script did not
# already control.
require_postgres_extensions() {
  for extension in $required_extensions; do
    printf '%s' "$extension" | grep -Eq '^[a-z][a-z0-9_]*$' ||
      die 'required extension name is malformed'

    available=$(compose exec -T postgres sh -c \
      "psql --username \"\$POSTGRES_USER\" --dbname \"\$POSTGRES_DB\" --no-psqlrc --quiet --tuples-only --no-align --command \"select count(*) from pg_available_extensions where name = '$extension'\"" \
      2>/dev/null) || die 'PostgreSQL is not answering capability queries'

    [ "$(printf '%s' "$available" | tr -d '[:space:]')" = '1' ] ||
      die "the PostgreSQL image does not provide a required extension: $extension"
  done
}

deploy_release() {
  sha=$1
  backend_digest=$2
  migration_digest=$3
  web_digest=$4
  platform_digest=$5
  migration_mode=$6

  validate_sha "$sha"
  for digest in "$backend_digest" "$migration_digest" "$web_digest" "$platform_digest"; do
    validate_digest "$digest"
  done

  # Everything from here to the migration step is a refusal, in the order that
  # keeps the cheapest and least reversible checks first. Nothing below may move
  # after `compose run --rm migrate`: migrations are forward-only, so a check
  # that runs afterwards is a diagnosis, not a gate.
  "$host_preflight" integrity
  "$host_preflight" disk "$required_free_mib"
  "$preflight" "$environment" "$runtime_env"

  export BACKEND_IMAGE="$registry/backend@sha256:$backend_digest"
  export BACKEND_MIGRATION_IMAGE="$registry/backend-migration@sha256:$migration_digest"
  export WEB_IMAGE="$registry/web@sha256:$web_digest"
  export PLATFORM_IMAGE="$registry/platform@sha256:$platform_digest"

  pull_release_images
  verify_release_declaration "$sha"
  verify_compose_images
  compose up -d --wait postgres redis geoipupdate
  require_postgres_extensions
  if [ "$migration_mode" = migrate ]; then
    compose run --rm migrate
  fi
  compose up -d --wait --no-deps backend
  require_running backend
  api_health
  compose up -d --wait --no-deps worker
  require_running worker
  compose up -d --wait --no-deps web platform
  require_running web
  require_running platform
  health

  if [ -f "$current_release" ]; then
    cp "$current_release" "$previous_release.tmp"
    mv "$previous_release.tmp" "$previous_release"
  fi
  write_release_manifest "$current_release" "$sha" "$backend_digest" \
    "$migration_digest" "$web_digest" "$platform_digest"
}

lock_deployment() {
  mkdir -p "$state_dir"
  exec 9>"$state_dir/deploy.lock"
  flock -n 9 || die 'another deployment is active'
}

# Reclaims the disk the superseded release was holding, and is called only after
# deploy_release returns.
#
# That ordering is structural rather than commented into place: deploy_release's
# last two statements are the PREVIOUS rotation and the CURRENT write, and
# retention's candidates are exactly the application images that are neither
# CURRENT nor PREVIOUS. Called any earlier, the release that has just started
# would not yet be recorded and would classify as removable.
#
# `reclaim-locked` rather than `reclaim` because this deployment already holds
# the lock. flock locks belong to an open file description, so retention
# inheriting descriptor 9 re-locks the one held here — immediate, not a deadlock
# — while `reclaim` would open the file again, get a distinct description, and be
# refused every time. Nothing is passed through the environment: the descriptor
# is the lock, not a claim about it.
run_retention() {
  # The release is deployed, healthy, and recorded before this runs. Retention is
  # disk hygiene, not part of the release, so its failure must not fail or undo a
  # deployment that has already succeeded — and must not be silent either. The
  # hard gate stays where it was: the next deployment's disk preflight, which is
  # the refusal that surfaced this problem in the first place.
  if "$retention" reclaim-locked "$required_free_mib"; then
    echo 'release retention: completed'
  else
    status=$?
    echo "release retention FAILED (exit $status): superseded release images were not reclaimed" >&2
    echo "this deployment is healthy and complete; investigate before the next release, which refuses below ${required_free_mib}MiB free" >&2
  fi
  return 0
}

manifest_value() {
  manifest=$1
  key=$2
  [ -r "$manifest" ] || die 'release manifest is not available'
  value=$(sed -n "s/.*\"${key}\":\"\([^\"]*\)\".*/\1/p" "$manifest")
  [ -n "$value" ] || die "release manifest field is missing: $key"
  printf '%s' "$value"
}

digest_from_manifest() {
  value=$(manifest_value "$1" "$2")
  case "$value" in
    sha256:*) digest=${value#sha256:} ;;
    *) die "release manifest digest is malformed: $2" ;;
  esac
  validate_digest "$digest"
  printf '%s' "$digest"
}

case "${1:-}" in
  deploy)
    [ "$#" -eq 7 ] || die 'deploy requires environment, SHA and four digests'
    lock_deployment
    deploy_release "$3" "$4" "$5" "$6" "$7" migrate
    run_retention
    ;;
  rollback)
    # Deliberately does not run retention. A rollback is incident response, and
    # adding an image mutation to it buys disk that the next deployment's own
    # preflight already guards; anything it could have reclaimed is still
    # reclaimable by the next forward deployment or by the standalone command.
    [ "$#" -eq 2 ] || die 'rollback requires environment'
    lock_deployment
    rollback_sha=$(manifest_value "$previous_release" sha)
    validate_sha "$rollback_sha"
    rollback_backend=$(digest_from_manifest "$previous_release" backend)
    rollback_migration=$(digest_from_manifest "$previous_release" migration)
    rollback_web=$(digest_from_manifest "$previous_release" web)
    rollback_platform=$(digest_from_manifest "$previous_release" platform)
    deploy_release "$rollback_sha" "$rollback_backend" "$rollback_migration" \
      "$rollback_web" "$rollback_platform" no-migrate
    ;;
  status)
    [ "$#" -eq 2 ] || die 'status requires environment'
    compose ps
    printf 'CURRENT_RELEASE='; sed -n '1p' "$current_release" 2>/dev/null || true
    printf 'PREVIOUS_RELEASE='; sed -n '1p' "$previous_release" 2>/dev/null || true
    ;;
  health)
    [ "$#" -eq 2 ] || die 'health requires environment'
    health
    ;;
  bootstrap-super-admin)
    # First-run only: creates the platform's first super administrator, which
    # no authorized route can create because granting that role is itself a
    # super-administrator action. The backend command refuses once one exists.
    #
    # Routed through this script rather than documented as a raw `docker
    # compose run` for one reason: the image. The compose file resolves the
    # backend to the mutable `:development` tag unless BACKEND_IMAGE is
    # exported, which only deploy_release does — so an ad-hoc invocation would
    # pull a tag from the registry and run it against the live database to mint
    # the platform's root credential. Here the digest comes from the recorded
    # release, so the account is created by exactly the image that is running.
    #
    # Deliberately absent from ai-agent-deploy-dispatch's allowlist, so it is
    # NOT reachable over the CI deploy key — only by someone with local root on
    # the host. Minting the platform's root credential must require host
    # access, not possession of a deployment secret. ops/tests/
    # lightsail-boundary.sh asserts that exclusion.
    #
    # `--interactive --tty` so the backend detects a terminal and takes its
    # hidden-prompt path with confirmation. Without a pty it would silently
    # take the piped path, and the operator would type the password into a
    # terminal that echoes it. Piping is deliberately not offered here: a
    # scripted bootstrap belongs against a checkout, not against a live host.
    # At least environment; the rest is forwarded to the backend command, which
    # validates its own flags and refuses --password.
    [ "$#" -ge 2 ] || die 'bootstrap-super-admin requires environment'
    shift 2
    lock_deployment
    bootstrap_digest=$(digest_from_manifest "$current_release" backend)
    BACKEND_IMAGE="$registry/backend@sha256:$bootstrap_digest" \
      compose run --rm --interactive --tty --no-deps backend \
      node dist/src/cli/main super-admin:create "$@"
    ;;
  rotate-managed-secret-keys)
    # Re-encrypts stored managed secrets under the configured active key
    # version. Needed because changing APP_ENCRYPTION_KEY re-encrypts nothing by
    # itself: until this has run, the previous key must stay configured in
    # APP_ENCRYPTION_DECRYPT_KEYS or those credentials cannot be read at all.
    #
    # Pinned to the recorded release digest for the same reason as the bootstrap
    # above — an ad-hoc `compose run` resolves the mutable `:development` tag,
    # which here would mean an arbitrary image reading and rewriting every
    # stored provider credential with the master key in its environment.
    #
    # Also deliberately absent from ai-agent-deploy-dispatch's allowlist: this
    # touches every credential the platform holds, so it must require local root
    # on the host rather than possession of the CI deploy key.
    # ops/tests/lightsail-boundary.sh asserts that exclusion.
    #
    # No pty, unlike the bootstrap: this command prompts for nothing and prints
    # a report. The remaining arguments are forwarded to the backend command,
    # which validates its own flags.
    [ "$#" -ge 2 ] || die 'rotate-managed-secret-keys requires environment'
    shift 2
    lock_deployment
    rotation_digest=$(digest_from_manifest "$current_release" backend)
    BACKEND_IMAGE="$registry/backend@sha256:$rotation_digest" \
      compose run --rm --no-deps backend \
      node dist/src/cli/main managed-secret:rotate-key "$@"
    ;;
  *) die 'unsupported operation' ;;
esac
