// Better Auth model/field names must match its generated schema; adapter
// mismatches fail at runtime. Business-history relations restrict deletion,
// while sessions and provider accounts cascade with their user.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Revalidated on read; stored preference is not a trusted locale.
  preferredLanguage String?

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // Separate from moderation bans so either lifecycle can be reversed alone.
  deletedAt       DateTime?
  // Audit attribution is intentionally not a relation.
  deletedByUserId String?
  deletionReason  String?

  sessions         Session[]
  accounts         Account[]
  memberships      Member[]
  invitations      Invitation[] @relation("InvitationInviter")
  agentRunsCreated AgentRun[]

  contentProjectsCreated ContentProject[] @relation("ContentProjectCreator")
  contentDraftsCreated   ContentDraft[]   @relation("ContentDraftCreator")

  featureFlagPlatformOverridesEdited     FeatureFlagPlatformOverride[]     @relation("FeatureFlagPlatformOverrideEditor")
  featureFlagOrganizationOverridesEdited FeatureFlagOrganizationOverride[] @relation("FeatureFlagOrganizationOverrideEditor")
  runtimeSettingsEdited                  RuntimeSetting[]                  @relation("RuntimeSettingEditor")
  managedSecretsEdited                   ManagedSecret[]                   @relation("ManagedSecretEditor")

  @@unique([email])
  @@index([deletedAt])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  country   String?
  city      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  // Request context only; membership and permissions are loaded separately.
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@index([activeOrganizationId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Better Auth's native limiter requires database-backed atomic state.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String
  logo      String?
  createdAt DateTime @default(now())
  metadata  String?

  locale              String  @default("ar")
  timezone            String  @default("UTC")
  currency            String  @default("USD")
  legalName           String?
  industry            String?
  websiteUrl          String?
  businessDescription String?

  // Separate CAS token so Better Auth name/slug writes cannot cause conflicts.
  businessProfileVersion   Int      @default(1)
  businessProfileUpdatedAt DateTime @default(now())

  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?

  members     Member[]
  invitations Invitation[]
  agentRuns   AgentRun[]

  agentInstallations     OrganizationAgentInstallation[]
  auditEvents            OrganizationAuditEvent[]
  toolExecutions         ToolExecution[]
  toolExecutionApprovals ToolExecutionApproval[]

  featureFlagOverrides FeatureFlagOrganizationOverride[]

  knowledgeSpaces    KnowledgeSpace[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]

  contentProjects ContentProject[]
  contentDrafts   ContentDraft[]

  @@unique([slug])
  @@index([archivedAt])
  @@map("organization")
}

model Member {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
  @@map("invitation")
}

// Independent of outbox delivery and BullMQ transport state.
enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@map("agent_run_status")
}

model AgentRun {
  id      String @id @default(uuid())
  agentId String

  // A queued run must resolve the definition accepted before a rollout.
  agentVersion Int

  runtime String
  status  AgentRunStatus @default(QUEUED)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Nullable only for rows written before version pinning was introduced.
  organizationAgentVersionId String?
  organizationAgentVersion   OrganizationAgentVersion? @relation(fields: [organizationAgentVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  // Nullable together for rows written before model pinning was introduced.
  modelPolicyId          String?
  modelId                String?
  modelPricingRevisionId String?

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  input  Json
  output Json?

  // Contains only bounded application diagnostics, never provider or stack text.
  lastError    String?
  attemptCount Int     @default(0)

  idempotencyKey String

  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  contentProjects ContentProject[]
  toolExecutions  ToolExecution[]

  @@unique([organizationId, idempotencyKey])
  // Composite target lets child relations enforce tenant agreement.
  @@unique([id, organizationId])
  @@index([createdByUserId])
  @@index([organizationAgentVersionId])
  // Supports bounded oldest-first reconciliation of non-terminal runs.
  @@index([status, updatedAt])
  @@map("agent_run")
}

model OrganizationAgentInstallation {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  agentId  String
  revision Int    @default(0)

  activeVersionId String?
  // The migration makes this FK commit-deferred so pointer CAS can precede insert.
  activeVersion   OrganizationAgentVersion?  @relation("ActiveOrganizationAgentVersion", fields: [activeVersionId, id], references: [id, installationId], onDelete: Restrict)
  versions        OrganizationAgentVersion[] @relation("OrganizationAgentVersions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, agentId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("organization_agent_installation")
}

model OrganizationAgentVersion {
  id String @id @default(uuid())

  organizationId String
  installationId String
  installation   OrganizationAgentInstallation @relation("OrganizationAgentVersions", fields: [installationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  revision          Int
  definitionVersion Int
  enabled           Boolean
  configuration     Json

  // Empty default preserves no-tool authority for older writers.
  toolGrants String[] @default([])

  modelPolicyId String?
  modelId       String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  activeFor OrganizationAgentInstallation[] @relation("ActiveOrganizationAgentVersion")
  runs      AgentRun[]

  @@unique([id, installationId])
  @@unique([id, organizationId])
  @@unique([installationId, revision], map: "organization_agent_version_installationId_revision_key")
  @@index([organizationId])
  @@index([installationId, createdAt, id])
  @@map("organization_agent_version")
}

enum ToolExecutionStatus {
  STARTED
  SUCCEEDED
  FAILED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  // Provider may have acted, so retrying would be unsafe.
  OUTCOME_UNKNOWN

  @@map("tool_execution_status")
}

enum ToolExecutionApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("tool_execution_approval_status")
}

model ToolExecution {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  agentRunAttempt Int

  toolId      String
  toolVersion Int

  status ToolExecutionStatus @default(STARTED)

  // Parsed application values; raw provider data is never stored here.
  input Json

  output Json?

  failureCode String?

  effectAttemptCount     Int       @default(0)
  effectFirstAttemptedAt DateTime?
  // Binds an approval to the exact stored side-effect proposal.
  effectPayloadDigest    String?
  providerMessageId      String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approval ToolExecutionApproval?

  @@unique([id, organizationId])
  @@index([organizationId, agentRunId, startedAt])
  @@index([organizationId, startedAt, id])
  @@map("tool_execution")
}

model ToolExecutionApproval {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  toolExecutionId String        @unique
  toolExecution   ToolExecution @relation(fields: [toolExecutionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  status ToolExecutionApprovalStatus @default(PENDING)

  // A changed proposal invalidates the approval.
  inputDigest String

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?

  decidedByUserId String?
  decisionNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([toolExecutionId, organizationId])
  @@index([organizationId, status, requestedAt, id])
  @@map("tool_execution_approval")
}

enum OutboxEventStatus {
  PENDING

  PROCESSING

  DELIVERED

  FAILED

  @@map("outbox_event_status")
}

model OutboxEvent {
  id String @id @default(uuid())

  type String

  payload Json

  // Fast transport dedupe only; consumers still enforce durable idempotency.
  dedupeKey String?

  status   OutboxEventStatus @default(PENDING)
  attempts Int               @default(0)

  availableAt DateTime @default(now())

  // Lease and claimant form the fencing claim used by conditional settlement.
  leaseExpiresAt DateTime?

  claimedBy String?

  lastError String?

  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, status, availableAt])
  @@index([type, status, leaseExpiresAt])
  @@map("outbox_event")
}

model FeatureFlagPlatformOverride {
  key     String  @id
  enabled Boolean

  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedByUser   User?    @relation("FeatureFlagPlatformOverrideEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("feature_flag_platform_override")
}

model FeatureFlagOrganizationOverride {
  id      String  @id @default(uuid())
  key     String
  enabled Boolean

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedByUser   User?    @relation("FeatureFlagOrganizationOverrideEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, key])
  @@index([updatedByUserId])
  @@map("feature_flag_organization_override")
}

model RuntimeSetting {
  key   String @id
  value Json

  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedByUser   User?    @relation("RuntimeSettingEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("runtime_setting")
}

model ManagedSecret {
  key String @id

  // AES-256-GCM parts are separate so tampering fails authentication.
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes

  algorithm      String
  keyFingerprint String
  // Null supports ciphertext written before the versioned keyring.
  keyVersion     String?

  label String?

  lastRotatedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedByUser   User?    @relation("ManagedSecretEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("managed_secret")
}

// Append-only by application contract; projections exclude credential material.
model ControlPlaneAuditEvent {
  id String @id @default(uuid())

  occurredAt DateTime @default(now())

  actorUserId String?

  resource    String
  action      String
  resourceKey String

  organizationId String?

  before Json?
  after  Json?

  @@index([occurredAt, id])
  @@index([resource, resourceKey, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("control_plane_audit_event")
}

// The owning migration rejects UPDATE/DELETE for the application database role.
model OrganizationAuditEvent {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  occurredAt DateTime @default(now())

  actorUserId String?

  action      String
  subjectType String
  subjectId   String

  before Json?
  after  Json?

  @@index([organizationId, occurredAt, id])
  // Explicit map matches PostgreSQL's truncated physical name and avoids drift.
  @@index([organizationId, subjectType, subjectId, occurredAt], map: "organization_audit_event_organizationId_subjectType_subjectId_o")
  @@map("organization_audit_event")
}

model KnowledgeSpace {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  slug String
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents KnowledgeDocument[]
  chunks    KnowledgeChunk[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("knowledge_space")
}

model KnowledgeDocument {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  spaceId String
  space   KnowledgeSpace @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  title String

  sourceUri String?

  checksum String

  revision Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@unique([organizationId, spaceId, title])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([spaceId])
  @@map("knowledge_document")
}

// Tenant identity is repeated so vector ranking is filtered before selection.
model KnowledgeChunk {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  spaceId String
  space   KnowledgeSpace @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  documentId String
  document   KnowledgeDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  ordinal Int
  content String

  // Prisma cannot write vector directly; ingestion attaches it with raw SQL.
  embedding Unsupported("vector(1536)")?

  embeddingModel String?

  createdAt DateTime @default(now())

  @@unique([documentId, ordinal])
  @@index([organizationId, spaceId])
  @@index([documentId])
  @@map("knowledge_chunk")
}

// Idea and brief are server-derived snapshots of the referenced run.
model ContentProject {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Composite reference makes cross-organization provenance impossible.
  sourceRunId String
  sourceRun   AgentRun @relation(fields: [sourceRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  sourceIdeaIndex Int

  topic    String
  goal     String
  audience String?
  guidance String?

  title           String
  hook            String
  angle           String
  summary         String
  suggestedFormat String

  language String

  createdByUserId String?
  createdByUser   User?   @relation("ContentProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  idempotencyKey String

  drafts ContentDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, createdAt, id])
  @@index([sourceRunId])
  @@index([createdByUserId])
  @@map("content_project")
}

// Revision 1 is a target; a null body means no content has been written.
model ContentDraft {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  projectId String
  project   ContentProject @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)

  revision Int

  title    String
  format   String
  language String

  body String?

  createdByUserId String?
  createdByUser   User?   @relation("ContentDraftCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, revision])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([projectId])
  @@index([createdByUserId])
  @@map("content_draft")
}
