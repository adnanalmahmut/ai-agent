# ==============================================================================
# Application variables (validated by Zod)
# ------------------------------------------------------------------------------
# Defined and validated by src/config/*.config.ts.
# Keep this section synchronized with the Zod schemas in src/config.
# ==============================================================================
NODE_ENV=development
APP_PORT=3002
APP_NAME=API Service
LOG_LEVEL=debug
LOG_PRETTY=true

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002/api/auth
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Public base URL of the Platform application, mount point included.
#
# Organization invitation links are built from this, because Better Auth
# deliberately does not generate them — taking the origin from a request
# header instead would let an attacker point the accept link at a host they
# control. The email's locale is appended, producing:
#
#   <APP_PLATFORM_URL>/<locale>/organizations/accept-invitation?id=<id>
#
# In production, with everything on one origin behind one reverse proxy:
#   APP_PLATFORM_URL=https://www.example.com/platform
APP_PLATFORM_URL=http://localhost:3001/platform

# --- Google sign-in -----------------------------------------------------------
# Disabled by default. While disabled, no Google variable is read and the
# application boots without them. Set GOOGLE_AUTH_ENABLED=true and the client
# id and secret become required — a missing or empty one fails at boot rather
# than at the first sign-in attempt.
#
# The redirect URI is derived from BETTER_AUTH_URL and must be registered in
# the Google Cloud Console for every environment:
#
#   <BETTER_AUTH_URL origin>/api/auth/callback/google
#
# Account linking runs on Better Auth's verified defaults: an existing account
# whose email is already verified links automatically, while an unverified one
# is refused — which is what blocks the pre-registration takeover.
GOOGLE_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ==============================================================================
# API documentation
# ------------------------------------------------------------------------------
# One Scalar UI at OPENAPI_PATH, serving two sources: the application schema at
# /openapi.json and Better Auth's own at /api/auth/open-api/generate-schema.
#
# Leaving OPENAPI_ENABLED unset means: on outside production, off in
# production. The documents enumerate every administrative and organization
# endpoint, so nobody should get them by forgetting to switch them off.
# Setting it to false also removes Better Auth's openAPI plugin, so its schema
# endpoint disappears rather than staying publicly reachable behind a hidden UI.
# ==============================================================================
# OPENAPI_ENABLED=true
# OPENAPI_PATH=/docs

# ==============================================================================
# Mail
# ------------------------------------------------------------------------------
# Only the *active* driver's settings are validated. Switching drivers never
# means filling in credentials for the ones you are not using, and a stale block
# below for an inactive provider cannot stop the application from starting.
#
#   log    development only — records metadata, sends nothing
#   resend RESEND_API_KEY
#   ses    AWS_REGION (+ optional static keys; omit them to use the IAM role)
#   smtp   SMTP_HOST (+ optional SMTP_USER/SMTP_PASSWORD)
#
# An unknown value fails at boot with the list of accepted drivers.
# ==============================================================================
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=API Service

# How long a real provider may be waited on, in milliseconds (1000–120000).
MAIL_TIMEOUT_MS=10000

# --- log driver ---------------------------------------------------------------
# Writes each rendered email to .tmp/mail/ so it can be opened in a browser.
# Development only: those files contain live, single-use auth tokens, and the
# application refuses to start with this enabled when NODE_ENV=production.
MAIL_LOG_WRITE_HTML=false

# --- resend driver ------------------------------------------------------------
# RESEND_API_KEY=

# --- ses driver ---------------------------------------------------------------
# Region is required. Leave the key pair unset wherever an IAM role is
# available (ECS/EKS/EC2): the AWS SDK resolves short-lived credentials through
# its own chain, which is preferable to long-lived keys in the environment.
# If you do set them, set BOTH — a lone key id is rejected at boot rather than
# silently falling through to the chain.
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- smtp driver --------------------------------------------------------------
# SMTP_SECURE=true means TLS from the first byte (port 465). Leave it false on
# 587, where the connection is upgraded with STARTTLS.
# Leave user and password unset for an unauthenticated local relay such as
# MailHog or Mailpit; set both together otherwise.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ==============================================================================
# Docker Compose variables
# ------------------------------------------------------------------------------
# Consumed by docker-compose.yml and the local database tooling.
# These are NOT part of the application's Zod-validated configuration.
# ==============================================================================
# Development database credentials
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Development database port
POSTGRES_PORT=5432

# Development database container name
POSTGRES_CONTAINER_NAME=backend_dev_postgres

# Test database credentials
POSTGRES_TEST_DB=backend_test
POSTGRES_TEST_USER=backend_test_user
POSTGRES_TEST_PASSWORD=backend_test_password

# Test database port
POSTGRES_TEST_PORT=5433

# Test database container name
POSTGRES_TEST_CONTAINER_NAME=backend_test_postgres

# Maximum memory available to the development PostgreSQL container
POSTGRES_MEM_LIMIT=512m

# Reserved memory for the development PostgreSQL container
POSTGRES_MEM_RESERVATION=256m

# Development Redis port
REDIS_PORT=6379

# Development Redis container name
REDIS_CONTAINER_NAME=backend_dev_redis

# Test Redis port. Deliberately not 6379: a suite that connected to the
# development instance would flush a developer's queues on its first cleanup.
REDIS_TEST_PORT=6378

# Test Redis container name
REDIS_TEST_CONTAINER_NAME=backend_test_redis

# Maximum memory available to the development Redis container
REDIS_MEM_LIMIT=256m

# Reserved memory for the development Redis container
REDIS_MEM_RESERVATION=64m
