// Better Auth schema (core + admin + organization) plus this application's
// own lifecycle state.
//
// The Better Auth half is not hand-designed: it was taken from
// `getAuthTables()` in the installed better-auth@1.6.27, called with this
// project's actual auth configuration, and compared field by field. That
// matters because the adapter addresses models as `prisma[modelName]` and
// fails at runtime — not at build time — when a column is missing.
//
// Relation field names follow the adapter's `getJoinKeyName` rule: singular on
// the side holding the foreign key (`Session.user`), pluralised on the other
// (`User.sessions`).
//
// ---------------------------------------------------------------------------
// Referential-action policy
// ---------------------------------------------------------------------------
// Identity roots are never physically deleted by this application: users are
// soft-deleted (`User.deletedAt`) and organizations are archived
// (`Organization.archivedAt`). Cascades therefore exist only where the child
// is genuinely worthless without its parent, and every one is justified here.
//
//   session.userId  -> Cascade   A session is ephemeral authentication state
//                                with no historical value, and Better Auth
//                                already deletes sessions wholesale via
//                                `deleteUserSessions`. Cascade matches the
//                                semantics that are already in force.
//   account.userId  -> Cascade   A provider linkage is meaningless without the
//                                identity it links to, and it is re-creatable
//                                by signing in again.
//
//   member.userId          -> Restrict
//   member.organizationId  -> Restrict
//   invitation.inviterId   -> Restrict
//   invitation.organizationId -> Restrict
//   agent_run.organizationId  -> Restrict
//   agent_run.createdByUserId -> Restrict (nullable; only when a creator exists)
//
// The six Restricts are deliberate. Membership, invitation, and agent-run rows
// carry history, and hard deletion of a user or an organization is not an
// operation this application offers. If a physical delete is ever attempted — by hand, by
// a future migration, or by a Better Auth route we failed to disable — it must
// fail loudly rather than quietly shredding organizational history.
//
// Deliberately absent: `UserPermissionOverride`, `team`, `teamMember`,
// `organizationRole`. Teams and dynamic access control are disabled, so their
// tables would be dead weight the schema promises to keep.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Outbound-message language for this account: 'ar' | 'en'.
  /// Nullable because an account may never have expressed a preference, and
  /// always re-validated through `parseAppLocale` on read — the column is a
  /// hint, never a trusted locale.
  preferredLanguage String?

  // --- Better Auth admin plugin ---------------------------------------------
  /// Comma-separated global role names; null means the plugin's `defaultRole`.
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // --- Application account lifecycle ----------------------------------------
  /// Set when the account is deactivated. A soft delete: every row below stays
  /// intact and the account can be restored by a `super_admin`.
  ///
  /// Independent of `banned`. A ban is a moderation decision; a deactivation is
  /// a lifecycle state. Restoring one must never clear the other, which is why
  /// this is a separate column rather than an overload of `banned`.
  deletedAt       DateTime?
  /// Who performed the deactivation. Not a relation: the actor is an audit
  /// fact, and a foreign key here would make the actor's own lifecycle depend
  /// on the records they touched.
  deletedByUserId String?
  deletionReason  String?

  sessions         Session[]
  accounts         Account[]
  memberships      Member[]
  invitations      Invitation[] @relation("InvitationInviter")
  agentRunsCreated AgentRun[]

  /// Control-plane edit attribution. `SetNull` on delete, because who changed
  /// a setting is useful history but must never block removing an account.
  featureFlagPlatformOverridesEdited     FeatureFlagPlatformOverride[]     @relation("FeatureFlagPlatformOverrideEditor")
  featureFlagOrganizationOverridesEdited FeatureFlagOrganizationOverride[] @relation("FeatureFlagOrganizationOverrideEditor")
  runtimeSettingsEdited                  RuntimeSetting[]                  @relation("RuntimeSettingEditor")
  managedSecretsEdited                   ManagedSecret[]                   @relation("ManagedSecretEditor")

  @@unique([email])
  @@index([deletedAt])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  /// Server-derived from ipAddress through the local GeoLite2 City database.
  country   String?
  /// Server-derived city label; never accepted from an auth request body.
  city      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Better Auth admin plugin ---------------------------------------------
  impersonatedBy String?

  // --- Better Auth organization plugin --------------------------------------
  /// Request context, never authorization. Proves only which organization the
  /// session has selected — membership and permission are read from `member`.
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@index([activeOrganizationId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Concurrency-safe storage required by Better Auth 1.6.x's native limiter.
/// Fields are derived from getAuthTables() for the installed version.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String
  logo      String?
  createdAt DateTime @default(now())
  metadata  String?

  // --- Application organization lifecycle -----------------------------------
  /// Set when the organization is archived. Every member, invitation and
  /// business resource survives; the organization simply becomes operationally
  /// inert (see `auth-hooks.ts`) until an owner or a `super_admin` restores it.
  ///
  /// Not declared to Better Auth. The organization plugin has no notion of a
  /// soft-deleted organization, so enforcement is ours and the column is read
  /// through `PrismaService`. Extra nullable columns are invisible to the
  /// adapter's create/update payloads.
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?

  members     Member[]
  invitations Invitation[]
  agentRuns   AgentRun[]

  agentInstallations OrganizationAgentInstallation[]

  featureFlagOverrides FeatureFlagOrganizationOverride[]

  knowledgeSpaces    KnowledgeSpace[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]

  @@unique([slug])
  @@index([archivedAt])
  @@map("organization")
}

model Member {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Comma-separated organization role names.
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email          String
  role           String?
  /// 'pending' | 'accepted' | 'rejected' | 'canceled'
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Agent execution
// ---------------------------------------------------------------------------

/// Durable business lifecycle for one accepted agent run.
/// Separate from both `OutboxEventStatus` (whether the queue publish happened)
/// and BullMQ's transport state (whether Redis currently holds a job).
enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@map("agent_run_status")
}

/// Durable authority for one background agent execution.
/// The runtime stays a string so adding a second application-supported runtime
/// is a code change, not inherently a database migration. `agentId` names an
/// application-owned definition; definitions are code, so it is deliberately
/// not a foreign key.
model AgentRun {
  id      String @id @default(uuid())
  agentId String

  /// The exact definition revision this run is pinned to. Asynchronous work
  /// must execute the definition that was current when it was accepted, so
  /// `(agentId, agentVersion)` — not `agentId` alone — identifies the code the
  /// worker resolves, including across a rolling deployment.
  agentVersion Int

  runtime String
  status  AgentRunStatus @default(QUEUED)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  /// Null means no authenticated application User initiated this run — for
  /// example scheduled or system-initiated work. It is not an actor
  /// abstraction and carries no other meaning.
  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// Application-owned input and result values. They are JSON so the database
  /// does not make a runtime SDK's request/result types canonical.
  input  Json
  output Json?

  /// Bounded diagnostic prose from the latest failed attempt. Never a stack,
  /// serialized provider response, or raw error cause.
  lastError    String?
  attemptCount Int     @default(0)

  /// Caller-supplied durable request identity, scoped to the organization.
  /// BullMQ's job id is a secondary optimization and cannot replace this.
  idempotencyKey String

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([createdByUserId])
  /// Serves the reconciliation sweep, which repeatedly asks for the oldest
  /// non-terminal runs. Without it that bounded query degrades into a full
  /// scan of a table whose terminal rows are never deleted, so its cost would
  /// grow with total history rather than with the backlog it is meant to find.
  @@index([status, updatedAt])
  @@map("agent_run")
}

/// One code-owned agent installed inside one organization.
///
/// The mutable facts are only `revision` and the pointer to the current
/// immutable version. `activeVersionId` is nullable so the installation and its
/// first version can be created in one transaction; application-created
/// committed rows always point at a version.
model OrganizationAgentInstallation {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  agentId  String
  revision Int    @default(0)

  activeVersionId String?
  activeVersion   OrganizationAgentVersion?  @relation("ActiveOrganizationAgentVersion", fields: [activeVersionId, id], references: [id, installationId], onDelete: Restrict)
  versions        OrganizationAgentVersion[] @relation("OrganizationAgentVersions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, agentId])
  /// Target for version ownership; the database keeps tenant identity aligned.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("organization_agent_installation")
}

/// One immutable effective state of an organization's installed agent.
///
/// Definition behavior remains code-owned. This row pins the exact code
/// definition revision plus the organization-owned, definition-validated
/// configuration and whether that effective state is enabled.
model OrganizationAgentVersion {
  id String @id @default(uuid())

  organizationId String
  installationId String
  installation   OrganizationAgentInstallation @relation("OrganizationAgentVersions", fields: [installationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  revision          Int
  definitionVersion Int
  enabled           Boolean
  configuration     Json

  /// Attribution without a foreign key so history cannot block or lose its
  /// actor during a future user lifecycle change.
  createdByUserId String?
  createdAt       DateTime @default(now())

  activeFor OrganizationAgentInstallation[] @relation("ActiveOrganizationAgentVersion")

  /// Target for the installation's active pointer; including installation id
  /// makes a cross-installation pointer a database constraint violation.
  @@unique([id, installationId])
  @@index([organizationId])
  @@index([installationId, createdAt, id])
  @@map("organization_agent_version")
}

// ---------------------------------------------------------------------------
// Transactional outbox
// ---------------------------------------------------------------------------
// The seam between "the request succeeded" and "the work was queued".
//
// Without it those two are one distributed write with no way to make them
// atomic: enqueue before committing and a rolled-back transaction leaves a job
// referencing a row that never existed; commit before enqueuing and a crash in
// between accepts work that nothing will ever perform. Both are silent.
//
// So the API writes the business row and a row here in one transaction, and a
// dispatcher in the worker process turns rows here into queue jobs. The result
// is at-least-once delivery — never at-most-once — which is why every consumer
// has to be safe to run twice.
//
// Deliberately generic. `type` and `payload` carry the event, so a new kind of
// asynchronous work needs no migration; the mapping from `type` to a queue and
// a job name lives in code, where it can be exhaustively checked.

/// Delivery lifecycle, entirely separate from any business lifecycle.
///
/// `DELIVERED` says a job reached the queue. It says nothing about whether the
/// work succeeded — that belongs to the business row the event refers to.
/// Conflating the two is how a failed agent run comes to look like an
/// undelivered event and gets published a second time.
enum OutboxEventStatus {
  /// Committed and waiting to be claimed.
  PENDING

  /// Claimed by a dispatcher, under a lease. Reclaimable once the lease expires
  /// — which is exactly what recovers an event whose dispatcher died mid-publish.
  PROCESSING

  /// Handed to the queue.
  DELIVERED

  /// Deterministically undeliverable: a payload that cannot be serialised, a
  /// job over the size limit. Never reached because the queue transport was
  /// down — an outage is retried for as long as it lasts, since the API already
  /// promised the caller this work was accepted. Parked rather than deleted:
  /// the row is the only record that accepted work was not performed.
  FAILED

  @@map("outbox_event_status")
}

model OutboxEvent {
  id String @id @default(uuid())

  /// Event type. Resolved to a queue and a job name in code, never here.
  type String

  /// The job payload, verbatim.
  payload Json

  /// Passed to BullMQ as the job id, when present.
  ///
  /// Collapses the duplicates that at-least-once delivery produces, and only
  /// those: BullMQ rejects a repeated id while the job still exists in Redis, so
  /// the guarantee expires with retention. Durable idempotency is a PostgreSQL
  /// UNIQUE constraint on the business row, not this column.
  dedupeKey String?

  status   OutboxEventStatus @default(PENDING)
  attempts Int               @default(0)

  /// Earliest time this event may be claimed. Moved forward on each failed
  /// publish, so a queue that is refusing writes is retried with backoff rather
  /// than hammered every poll.
  availableAt DateTime @default(now())

  /// When the current claim lapses. The crash-recovery window: a dispatcher that
  /// dies between `queue.add()` and the `DELIVERED` write leaves the row claimed,
  /// and nothing re-delivers it until this passes.
  leaseExpiresAt DateTime?

  /// Which dispatcher holds the claim.
  ///
  /// Read as half of the claim version, not merely for audit. `reschedule` and
  /// `markFailed` match on `(claimedBy, attempts)`, so a dispatcher whose lease
  /// lapsed while a newer one reclaimed and delivered the row updates zero rows
  /// instead of dragging `DELIVERED` back to `PENDING` or down to `FAILED`.
  ///
  /// `markDelivered` is deliberately exempt: a successful publish is a fact, and
  /// leaving a delivered row `PROCESSING` would schedule a pointless re-delivery.
  claimedBy String?

  /// Last publish failure, for diagnosis. Truncated by the dispatcher: a
  /// provider error can carry an entire request, and this column is read by
  /// people rather than by code.
  lastError String?

  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// The claim query's indexes. `type` leads both, because every claim filters
  /// on the types this worker build can route before it looks at anything else —
  /// that filter is what stops an old worker destroying an event written by a
  /// newer API during a rollout.
  @@index([type, status, availableAt])
  /// The reclaim half of the same query: `PROCESSING` rows whose lease lapsed.
  @@index([type, status, leaseExpiresAt])
  @@map("outbox_event")
}

// ---------------------------------------------------------------------------
// Control plane
// ---------------------------------------------------------------------------
// Operational state an operator may change without a deployment, kept
// deliberately separate from two things it is often confused with.
//
// It is not bootstrap configuration. `DATABASE_URL`, `REDIS_URL`,
// `BETTER_AUTH_SECRET` and the secret-encryption master key cannot live here,
// because they are what the application needs in order to reach the database
// these rows are in.
//
// It is also not agent behaviour. Prompts, context policy and input/output
// schemas belong to a versioned definition in code: a durable AgentRun accepted
// against version 1 must still execute version 1 tomorrow, and a mutable row
// cannot promise that. Changing behaviour publishes a new version.
//
// What is left is genuinely operational: whether a feature accepts new work,
// bounded numeric and enumerated tuning values, and provider credentials.

/// A platform-wide feature-flag override.
///
/// Separate from the organization-scoped table rather than one table with a
/// nullable `organizationId`, because PostgreSQL treats NULLs as distinct in a
/// unique index — so the single most important constraint here, "at most one
/// platform override per key", would silently not hold. Two tables state the
/// precedence in the schema instead of in a comment.
model FeatureFlagPlatformOverride {
  key     String  @id
  enabled Boolean

  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedByUser   User?    @relation("FeatureFlagPlatformOverrideEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("feature_flag_platform_override")
}

/// A feature-flag override for one organization, which wins over the platform
/// override and the code default.
model FeatureFlagOrganizationOverride {
  id      String  @id @default(uuid())
  key     String
  enabled Boolean

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedByUser   User?    @relation("FeatureFlagOrganizationOverrideEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, key])
  @@index([updatedByUserId])
  @@map("feature_flag_organization_override")
}

/// One operator-editable setting, whose key must exist in the code-owned
/// registry and whose value must satisfy that entry's Zod schema.
///
/// The value is JSON because the registry — not the column — decides each
/// setting's type. Storing text and parsing on read would make every consumer
/// re-derive the type, and a typed column per setting would make adding one a
/// migration.
model RuntimeSetting {
  key   String @id
  value Json

  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedByUser   User?    @relation("RuntimeSettingEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("runtime_setting")
}

/// A provider credential, encrypted at rest with the application master key.
///
/// The plaintext is never returned by any read surface and never enters
/// `process.env`; it is decrypted only when an adapter is about to use it. What
/// the control plane can show is everything in this model except `ciphertext`.
///
/// `keyFingerprint` is a non-secret digest of the master key that encrypted the
/// row. Without it, decrypting after the master key changed produces an
/// authentication failure indistinguishable from corruption; with it the
/// application can say which of the two happened.
model ManagedSecret {
  key String @id

  ciphertext Bytes
  /// The GCM nonce. Unique per encryption, stored beside the ciphertext
  /// because decryption needs it and it is not secret.
  iv         Bytes
  /// The GCM authentication tag, which is what makes a tampered ciphertext a
  /// loud failure rather than silent garbage.
  authTag    Bytes

  algorithm      String
  keyFingerprint String

  /// A non-secret hint — never the value, never a prefix of it — so an
  /// operator can tell two credentials apart in a list.
  label String?

  lastRotatedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedByUser   User?    @relation("ManagedSecretEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("managed_secret")
}

/// An append-only record of one control-plane mutation.
///
/// The control-plane rows themselves carry `updatedByUserId` and `updatedAt`,
/// which answers "who touched this last" and nothing else. Every question an
/// operator actually asks after an incident is a question about history: when
/// was this switched on, who switched it, what was it before, and was it ever
/// set at all. A last-writer column cannot answer any of them, and clearing an
/// override deletes the row and the only attribution with it — so the moment
/// the evidence matters most is the moment it stops existing.
///
/// Append-only is a property of the code, not of a grant: nothing in the
/// application updates or deletes a row here, and the read surface is a
/// paginated listing with no mutations beside it. Deliberately scoped to the
/// control plane rather than generalized — a business-wide audit framework is a
/// different feature with different retention, different authorization, and a
/// much larger surface to get wrong.
///
/// ## What must never be in it
///
/// No secret plaintext, no ciphertext, no IV, no auth tag, and no value from a
/// runtime setting the registry marks as anything other than public. A managed
/// secret's events carry only whether a slot became configured, was rotated, or
/// was removed, plus the operator's own non-secret label. That is enforced in
/// `control-plane-audit.service.ts`, where the safe projection for each
/// resource is built, and asserted by tests that push a canary credential
/// through every mutation and search the row, the API response and the log for
/// it.
model ControlPlaneAuditEvent {
  id String @id @default(uuid())

  /// When the mutation committed. The listing pages on `(occurredAt, id)` so
  /// two events in the same millisecond still have a total order.
  occurredAt DateTime @default(now())

  /// Who did it. Nullable because an event can outlive its actor's row, and
  /// deliberately not a relation: an audit fact must not become a reason a
  /// user row cannot be removed, and `SetNull` on a relation would erase the
  /// attribution this table exists to keep.
  actorUserId String?

  /// Which control-plane resource: `featureFlag`, `runtimeSetting`, or
  /// `managedSecret`. A string rather than an enum because adding a resource
  /// should not be a migration on a log table.
  resource String
  /// What was done to it, as `resource.verb` — `featureFlag.setOrganizationOverride`.
  action String
  /// The registry key the action addressed.
  resourceKey String

  /// Present only for organization-scoped feature-flag overrides.
  organizationId String?

  /// The safe projection of the resource before and after the mutation.
  ///
  /// JSON because each resource's safe shape is different and none of them is
  /// worth a column. A null `before` means the resource had no stored state —
  /// which is itself the fact worth recording, since "first configured" and
  /// "changed" are different events.
  before Json?
  after  Json?

  /// Newest first, and the pair the cursor pages on.
  @@index([occurredAt, id])
  /// The other question this table is asked: the history of one key.
  @@index([resource, resourceKey, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("control_plane_audit_event")
}

// ---------------------------------------------------------------------------
// Knowledge
// ---------------------------------------------------------------------------
// Organization-owned reference material, chunked and embedded so an agent can
// be given the parts of it that bear on a request.
//
// Every one of these three tables carries `organizationId`, including the two
// that could derive it through a parent. That is denormalization on purpose:
// the tenant predicate has to sit in the same row as the vector, so the
// ranking query can be scoped without a join. A join is a thing a future query
// can forget, and forgetting it here returns another organization's material.
//
// All three restrict organization deletion, like every other business table.

/// A named collection of documents inside one organization.
///
/// Spaces exist so an agent can be pointed at *some* of an organization's
/// material rather than all of it: `content-idea@1` reads brand and product
/// notes and has no business reading a support archive. The set an agent may
/// see is declared in its code-owned context policy, not chosen at call time.
model KnowledgeSpace {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  /// Stable, human-written, and unique within the organization. A context
  /// policy names spaces by slug, so a policy stays readable in code review
  /// and does not embed a uuid that differs per deployment.
  slug String
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents KnowledgeDocument[]
  chunks    KnowledgeChunk[]

  @@unique([organizationId, slug])
  /// The target of the composite foreign keys below. Its only job is to let a
  /// child reference `(id, organizationId)` as a pair, so the database — not a
  /// convention — guarantees the two agree.
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("knowledge_space")
}

/// One source text, before it was split.
///
/// Kept as a row of its own rather than folded into the chunks so a retrieved
/// passage can say where it came from, and so re-ingesting a changed source
/// replaces a known set of chunks instead of accumulating duplicates.
model KnowledgeDocument {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  spaceId String
  /// Referenced as a pair with `organizationId`, so a document cannot be filed
  /// into a space belonging to a different organization.
  space   KnowledgeSpace @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  title String

  /// Where the text came from, when it came from somewhere addressable. Free
  /// text and never dereferenced by this application.
  sourceUri String?

  /// A digest of the source text, so ingestion can tell an unchanged document
  /// from one that has to be re-split and re-embedded — which costs a provider
  /// call per chunk.
  checksum String

  /// How many times the body has been replaced, starting at one.
  ///
  /// There is deliberately no revision *history*. Keeping superseded chunks
  /// would mean either retrieving stale passages or carrying an is-current
  /// predicate through the one query whose predicates are the isolation
  /// guarantee. This counter exists so a caller can see that a re-ingestion
  /// changed something, and so the outbox event for one edit is distinct from
  /// the event for the next.
  revision Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks KnowledgeChunk[]

  /// A document is addressed by title within its space, which is what makes
  /// re-submitting a source an update rather than a duplicate.
  @@unique([organizationId, spaceId, title])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([spaceId])
  @@map("knowledge_document")
}

/// One passage and its embedding.
///
/// `embedding` is `Unsupported` because Prisma has no vector type, and it is
/// *nullable* because a required `Unsupported` field removes `create`,
/// `createMany` and `upsert` from the generated delegate entirely — verified
/// against the installed 7.9.1. A row is therefore written first and its
/// vector set by a raw `UPDATE`, and a chunk whose embedding is still null is
/// simply not retrievable yet.
///
/// There is deliberately no vector index. An approximate index changes which
/// rows come back, and the tenant predicate is applied *after* the index scan
/// — so a scoped query under HNSW returns whichever of the requested rows
/// happen to survive the filter, silently short. Prisma also cannot represent
/// such an index and emits `DROP INDEX` for it on every subsequent migration,
/// so it would not survive a forward-only pipeline in any case. Exact search
/// needs no index; the btree below is what pgvector's own guidance recommends
/// for a filter this selective.
model KnowledgeChunk {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  /// Both parents are referenced as a pair with `organizationId`.
  ///
  /// `organizationId` on this row is the entire scoping predicate — retrieval
  /// filters on it and on `spaceId`, in the same statement that ranks. Left as
  /// three independent foreign keys, nothing but the correctness of whatever
  /// writes the row would keep the three tenant answers in agreement, and the
  /// isolation guarantee would be a convention rather than a constraint. As a
  /// pair, a chunk that claimed one organization while sitting in another's
  /// space is rejected by PostgreSQL.
  spaceId String
  space   KnowledgeSpace @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  documentId String
  document   KnowledgeDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// Position within the document, so a retrieved passage can be placed.
  ordinal Int
  content String

  /// 1536 dimensions: `text-embedding-3-small` native, and reachable by
  /// `text-embedding-3-large` through its `dimensions` parameter — so two
  /// further models remain available without a table rewrite and a full
  /// re-embedding.
  embedding Unsupported("vector(1536)")?

  /// Which model produced the vector.
  ///
  /// Two models' embeddings are not comparable — the numbers occupy different
  /// spaces and the distance between them is arithmetic rather than meaning.
  /// 1536 dimensions was chosen so `text-embedding-3-large` can replace
  /// `text-embedding-3-small` without a column change, which means the swap
  /// will not be forced through a migration that stops traffic: during
  /// re-embedding the table holds both. Retrieval therefore *filters* on this
  /// column rather than merely recording it, so a query ranks within one model
  /// or returns nothing, never across two.
  embeddingModel String?

  createdAt DateTime @default(now())

  @@unique([documentId, ordinal])
  @@index([organizationId, spaceId])
  @@index([documentId])
  @@map("knowledge_chunk")
}
