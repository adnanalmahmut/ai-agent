# The administrative surface. Rendered into the proxy routes on staging only.
#
# Two locations, because `^~ /admin/` does not match `/admin` itself and a
# prefix written without the trailing slash would also match `/administrators`.
# Both carry the same ingress restriction, so the pages, the assets under
# `/admin/_next/` and the auth forwarder under `/admin/api/auth/` are all
# behind it. Protecting the page and leaving the way in open would protect
# nothing.
#
# The restriction is not an authorization. It decides who may reach this
# surface at all; who may use it is decided by the reader's session and by the
# Control Plane's own check on every administrative request, which is where
# authority lives and stays. Reaching the surface from an allowlisted address
# makes nobody staff. See docs/security.md.
location = /admin {
    include /etc/nginx/ai-agent-admin-ingress.conf;

    proxy_pass http://127.0.0.1:__ADMIN_PORT__;
    include /etc/nginx/snippets/ai-agent-proxy-common.conf;
}

location ^~ /admin/ {
    include /etc/nginx/ai-agent-admin-ingress.conf;

    proxy_pass http://127.0.0.1:__ADMIN_PORT__;
    include /etc/nginx/snippets/ai-agent-proxy-common.conf;
}
