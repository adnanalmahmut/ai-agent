#!/bin/sh
set -eu

# ForcedCommand entrypoint. SSH_ORIGINAL_COMMAND is data, never evaluated.
command=${SSH_ORIGINAL_COMMAND:-}
printf '%s\n' "$command" | grep -Eq '^(deploy (staging|production) [0-9a-f]{40}( [0-9a-f]{64}){4}|(status|health|rollback) (staging|production))$' || {
  echo 'command rejected' >&2
  exit 64
}
set -- $command

case "${1:-}" in
  deploy)
    [ "$#" -eq 7 ] || exit 64
    exec sudo -n /usr/local/sbin/ai-agent-deploy deploy "$2" "$3" "$4" "$5" "$6" "$7"
    ;;
  status|health|rollback)
    [ "$#" -eq 2 ] || exit 64
    exec sudo -n /usr/local/sbin/ai-agent-deploy "$1" "$2"
    ;;
  *)
    echo 'allowed commands: deploy <environment> <sha> <backend-digest> <migration-digest> <web-digest> <platform-digest>, status|health|rollback <environment>' >&2
    exit 64
    ;;
esac
