{
  "name": "@repo/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "import": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./generated": {
      "types": "./src/generated/index.ts",
      "import": "./src/generated/index.ts",
      "default": "./src/generated/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "api:types": "node scripts/generate-api-types.mjs",
    "api:types:check": "git ls-files --error-unmatch src/generated/application-api.generated.ts && node scripts/generate-api-types.mjs && git diff --exit-code -- src/generated/application-api.generated.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  }
}
