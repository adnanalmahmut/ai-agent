{
  "name": "@repo/execution-contracts",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test-d.json",
    "execution:contracts": "node scripts/generate.mjs",
    "execution:contracts:check": "git ls-files --error-unmatch src/generated/schemas.ts src/generated/types.ts && node scripts/generate.mjs && git diff --exit-code -- src/generated",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5"
  }
}
