{
  "name": "ai-agents",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "pnpm run build:packages",
    "dev": "pnpm run build:packages && pnpm --parallel --filter './apps/*' --filter './packages/*' run dev",
    "dev:backend": "pnpm run build:packages && pnpm --filter control-plane dev",
    "start:backend": "pnpm --filter control-plane start",
    "dev:worker": "pnpm run build:packages && pnpm --filter control-plane worker:dev",
    "start:worker": "pnpm --filter control-plane worker:prod",
    "cli": "pnpm --filter control-plane cli",
    "dev:web": "pnpm run build:packages && pnpm --filter web dev",
    "dev:platform": "pnpm run build:packages && pnpm --filter platform dev",
    "build:platform": "pnpm run build:packages && pnpm --filter platform build",
    "build": "pnpm run build:packages && pnpm --filter './apps/*' run build",
    "build:packages": "pnpm --filter './packages/*' run build",
    "build:backend": "pnpm run build:packages && pnpm --filter control-plane build",
    "build:web": "pnpm run build:packages && pnpm --filter web build",
    "api:types": "pnpm --filter @repo/api-client run api:types",
    "api:types:check": "pnpm --filter @repo/api-client run api:types:check",
    "typecheck": "pnpm --recursive run typecheck",
    "agents:check": "node .agents/scripts/agents-check.mjs && node --test .agents/hooks/__tests__/*.test.mjs .agents/scripts/__tests__/*.test.mjs",
    "agents:resume": "node .agents/scripts/resume-task.mjs",
    "typecheck:backend": "pnpm --filter control-plane run typecheck",
    "lint": "pnpm --recursive run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "test": "pnpm --recursive run test",
    "test:backend": "pnpm --filter control-plane test",
    "test:e2e": "pnpm --filter control-plane test:e2e",
    "db:up": "infra/scripts/compose.sh --profile development up -d postgres redis",
    "db:down": "infra/scripts/compose.sh --profile development down",
    "db:logs": "infra/scripts/compose.sh --profile development logs -f postgres redis",
    "db:generate": "pnpm --filter control-plane prisma:generate",
    "db:validate": "pnpm --filter control-plane prisma:validate",
    "db:migrate": "pnpm --filter control-plane db:migrate",
    "db:create-only": "pnpm --filter control-plane db:create-only",
    "db:deploy": "pnpm --filter control-plane db:deploy",
    "db:reset": "pnpm --filter control-plane db:reset",
    "db:push": "pnpm --filter control-plane db:push",
    "db:studio": "pnpm --filter control-plane db:studio",
    "ui:add": "pnpm dlx shadcn@latest add -c packages/ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.29.3"
}
